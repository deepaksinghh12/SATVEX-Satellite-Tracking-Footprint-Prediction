# Django Secret Key (Generate a random secret in production)
SECRET_KEY=replace-with-a-secure-random-secret-key

# Debug mode (set to False in production)
DEBUG=False

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,satvex.deepaksinghdev.in,satvex-api.deepaksinghdev.in,.onrender.com

# CSRF Trusted Origins (comma-separated with https://)
CSRF_TRUSTED_ORIGINS=https://satvex.deepaksinghdev.in,https://satvex-api.deepaksinghdev.in,https://*.onrender.com

# Optional Database URL (PostgreSQL / SQLite). If omitted, SQLite db.sqlite3 will be used.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# N2YO Satellite API Key (optional for real-time TLE fetching)
N2YO_API_KEY=your-n2yo-api-key-here

# Port (set automatically by hosting environments like Render)
PORT=8000
